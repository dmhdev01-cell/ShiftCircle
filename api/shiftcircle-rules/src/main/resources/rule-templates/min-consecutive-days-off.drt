template header
code
withinDays
minimumBreakHours
severity
overridePolicy
message

package ca.shiftcircle.rules.tables.daysoff

import ca.shiftcircle.rules.facts.DaysOffFact;
import ca.shiftcircle.rules.facts.RuleOutcome;
import ca.shiftcircle.rules.facts.RuleResult;
import ca.shiftcircle.rules.model.OverridePolicy;

global java.util.List ruleResults;
global String ruleSetVersion;

// One row = the days-off requirement (U-12). Two consecutive days off is 48 hours without a shift;
// minimumBreakHours comes from the days-off count, not from the "a break of 24 h or less does not
// count" note, which only says a single short break cannot be counted as a day.
template "min_consecutive_days_off"

rule "@{code} row @{row.rowNumber}"
when
    $f : DaysOffFact(
            windowDays == @{withinDays},
            longestBreakHours < @{minimumBreakHours} )
then
    ruleResults.add( new RuleResult(
        "@{code}",
        "DAYS_OFF",
        RuleOutcome.@{severity},
        "@{message}",
        @{minimumBreakHours},
        $f.getLongestBreakHours(),
        "hours",
        OverridePolicy.@{overridePolicy},
        ruleSetVersion,
        $f.getEvidence() ) );
end

end template
