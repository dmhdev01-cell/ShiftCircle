# Line endings: LF in every checkout, whatever core.autocrlf says (Git for Windows defaults
# to CRLF, which broke install.sh's .env parsing: exit 17). Windows-only scripts keep CRLF.
* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
# Binary, never converted.
*.png binary
*.jpg binary
*.mp4 binary
