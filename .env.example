# Copy to .env and set the two secrets. .env is gitignored and must never be committed.
# The API refuses to start if POSTGRES_PASSWORD or SC_JWT_SECRET is missing or too short.
POSTGRES_DB=shiftcircle
POSTGRES_USER=shiftcircle
POSTGRES_PASSWORD=
SC_JWT_SECRET=

# demo = seeded synthetic data + mock sign-in; prod-like = neither.
SC_PROFILE=demo

# The "today" the demo pretends it is, and the generator seed (docs/10-testing.md §6).
SC_DEMO_TODAY=2026-11-19
SC_DEMO_SEED=20261001

# Optional: the git commit shown at /api/v1/version. Set before `docker compose up --build`:
#   SC_GIT_COMMIT=$(git rev-parse --short HEAD)
SC_GIT_COMMIT=

# Only needed when port 8080 is already in use on this machine.
# SC_WEB_PORT=9090
